												|en = 'The user (actor)'"));
	ФормыПредставления.Добавить("boundary", НСтр("ru = 'Граничный элемент';
												|en = 'Boundary element'"));
	ФормыПредставления.Добавить("control", НСтр("ru = 'Управляющий элемент';
												|en = 'The control element'"));
	ФормыПредставления.Добавить("entity", НСтр("ru = 'Сущность';
												|en = 'Entity'"));
